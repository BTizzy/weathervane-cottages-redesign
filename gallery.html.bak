    <!-- COTTAGES -->
    <section class="gallery-section section" id="cottages" aria-labelledby="gal-cottages-heading">
      <div class="container">
        <div class="gallery-section__header reveal">
          <svg class="icon-key" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="8" cy="15" r="4" stroke="currentColor" stroke-width="1.6"/><path d="M11.5 12.5 20 4M17 4h3v3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <h2 id="gal-cottages-heading">Cottages</h2>
        </div>
        <div class="gallery-grid" data-gallery="cottages">
          <button class="gallery__item reveal" type="button" data-index="0">
            <img src="assets/property/cottage-exterior-1.jpg" alt="Cottage exterior among the greenery" width="800" height="600" loading="lazy">
          </button>
          <button class="gallery__item reveal" type="button" data-index="1">
            <img src="assets/property/cottage-exterior-2.jpg" alt="Cottage exteriors along the property" width="800" height="600" loading="lazy">
          </button>
          <button class="gallery__item reveal" type="button" data-index="2">
            <img src="assets/rooms/interior-1.jpg" alt="Cottage bedroom with queen bed" width="800" height="600" loading="lazy">
          </button>
          <button class="gallery__item reveal" type="button" data-index="3">
            <img src="assets/rooms/bath-1.jpg" alt="Cottage bathroom" width="800" height="600" loading="lazy">
          </button>
          <button class="gallery__item reveal" type="button" data-index="4">
            <img src="assets/rooms/interior-5.jpg" alt="Cottage interior detail" width="800" height="600" loading="lazy">
