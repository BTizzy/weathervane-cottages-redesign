  <main id="main">
    <section class="page-hero" aria-labelledby="page-heading">
      <div class="page-hero__media">
        <img src="assets/property/sunset-4.jpg" alt="Weathervane Cottages property at blue hour" width="1920" height="900" fetchpriority="high">
        <div class="page-hero__veil" aria-hidden="true"></div>
      </div>
      <div class="page-hero__content container">
        <p class="eyebrow eyebrow--on-dark">Galleries</p>
        <h1 id="page-heading" class="text-on-dark">Weathervane in <em>pictures</em></h1>
        <p class="page-hero__lede text-on-dark">Cottages, gardens, fire pits, and the quiet corners of the property — a visual walk through the retreat.</p>
      </div>
    </section>

    <!-- Category nav -->
    <nav class="gallery-nav section" aria-label="Gallery categories">
      <div class="container">
        <ul class="gallery-nav__list reveal">
          <li><a href="#cottages">Cottages</a></li>
          <li><a href="#interiors">Interiors</a></li>
          <li><a href="#fire-pits">Fire Pits &amp; Evenings</a></li>
