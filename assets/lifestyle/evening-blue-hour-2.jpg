<style id="wp-custom-css">
/* Logo: #264039 */

.cmsmasters_open_project .project_features_item_title {
  float: none;
}
.cmsmasters_open_project .project_features_item_desc {
  padding: 0 0 0 0;
  word-wrap: break-word;
  text-align: justify;
	text-align-last: left;
  overflow: hidden;
}

.headline_color{
	background: linear-gradient(180deg, rgba(37,41,48,1) 0%, rgba(0,0,0,0.2) 44%); }

.headline_outer{
	background-position:center center;
}

#ect-events-list-content .style-2 .modern-list-right-side {
	background: #264039;
}

#header{
	background-color:rgba(37,41,48,.75)  !important;
}


/* NAV: Check Availability button*/
#menu-item-15471 .nav_title{
	background-color:white;
	color:#16202F;
	padding: 5px 10px;
	border:1px solid white;
}
#menu-item-14969 .nav_title:hover{
	color:white;
	background-color:transparent;
}
.cmsmasters_open_project .project_details_item_desc {
	text-align: left;
}
.cmsmasters_open_project .project_features_item_title {
	max-width: 100%;
	margin-bottom: 12px;
}
#newbook_content :is(ul,ol):not(.chosen-results):not(.newbook-unslider-wrap):not(#newbook_online_category_features_list):not(.chosen-choices):not(.flip):not(.category_image_overlay):last-child {
	height: 16px;
	position: absolute;
	bottom: 10px;
}
</style>
</head>
